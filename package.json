    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.4.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.0",
    "less": "^4.1.0",
    "less-loader": "^11.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.1.0",
