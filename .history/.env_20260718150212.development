# 开发环境配置
VITE_APP_TITLE=Vue3+TS+Webpack
VITE_APP_MODE=development
VITE_API_BASE_URL=/api

# GitHub 登录真实配置 (已通过 vite.config.ts 自动兼容读取你 Windows 本地的 github_client_id/client_id 系统变量)
VITE_GITHUB_REDIRECT_URI=http://117.72.222.3/oauth/callback/github

# Gitee 登录真实配置 (已通过 vite.config.ts 自动兼容读取你 Windows 本地的 Client_ID_gitee/gitee_client_id 系统变量)
VITE_GITEE_REDIRECT_URI=http://localhost:5172/oauth/callback/gitee
